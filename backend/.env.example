# Backend environment for `npm run dev:real` (real Bedrock calls).
# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# Your Amazon Bedrock API key (a bearer token, e.g. starts with "ABSK...").
# Generate one in the AWS console: Amazon Bedrock -> API keys.
# The AWS SDK reads this automatically; no IAM access keys required.
AWS_BEARER_TOKEN_BEDROCK=paste-your-bedrock-api-key-here

# Region the key was generated for (short-term keys are region-scoped).
AWS_REGION=us-east-1

# Model to invoke. Must be enabled under Bedrock -> Model access in this region.
# Note: Claude 4.x models require a cross-region inference profile ID (the "us."
# prefix), not the raw foundation-model ID.
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-1-20250805-v1:0

# Optional: change the local port (defaults to 3000).
# PORT=3000

bedrock-api-key-